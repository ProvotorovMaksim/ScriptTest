<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../spaceengineers.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>SpaceEngineers.Apps.Radar</RootNamespace>
    <AssemblyName>Radar</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <ItemGroup>
      <Compile Include="Program.cs" />
      <Compile Include="../../libs/radar-core/CameraManager.cs" />
      <Compile Include="../../libs/radar-core/ContactObservation.cs" />
      <Compile Include="../../libs/radar-core/ContactTracker.cs" />
      <Compile Include="../../libs/radar-core/PositionPredictor.cs" />
      <Compile Include="../../libs/radar-core/RadarConfig.cs" />
      <Compile Include="../../libs/radar-core/RadarState.cs" />
      <Compile Include="../../libs/radar-core/GimbalController.cs" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.PbPackager" Version="2.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
