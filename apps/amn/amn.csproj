<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../spaceengineers.props" />

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>SpaceEngineers.Apps.Amn</RootNamespace>
    <AssemblyName>AMN.Base</AssemblyName>
  </PropertyGroup>

  <PropertyGroup>
    <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../libs/igc-core/**/*.cs" Exclude="../../libs/igc-core/obj/**;../../libs/igc-core/bin/**" />
    <Compile Include="../../libs/taskbus-producer/**/*.cs" Exclude="../../libs/taskbus-producer/obj/**;../../libs/taskbus-producer/bin/**" />
    <Compile Include="../../libs/taskbus-consumer/**/*.cs" Exclude="../../libs/taskbus-consumer/obj/**;../../libs/taskbus-consumer/bin/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Mal.Mdk2.PbPackager" Version="2.3.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>