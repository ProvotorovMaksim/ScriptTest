# Normalize line endings for cross-platform consistency
* text=auto

# C# source files — store as LF in repo
*.cs text eol=lf

# Project and config files
*.csproj text eol=lf
*.props text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# Binary — do not touch
*.dll binary
*.pdb binary
*.exe binary
*.app binary
*.nupkg binary
